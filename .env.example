# ── Supabase ─────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── Upload-Post ──────────────────────────────────────────
# https://app.upload-post.com/api-keys
# White-label linking is included from the Professional plan up.
UPLOADPOST_API_KEY=your-upload-post-api-key

# ── Admin (Managed plan workflow) ────────────────────────
# Comma-separated emails allowed to compose on behalf of clients:
ADMIN_EMAILS=you@socialpostinginc.com

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_SELF_SERVE=price_...   # $29/mo price ID
NEXT_PUBLIC_STRIPE_PRICE_MANAGED=price_...      # $399/mo price ID

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
