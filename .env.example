# ── Supabase ─────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000          # production: https://app.socialpostinginc.com
# Encrypts social tokens in the database. Generate once, never change:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Protects the every-minute scheduler endpoint. Any long random string:
#   openssl rand -hex 24
CRON_SECRET=
# Emails allowed to see the Clients page and post for Done-for-you clients:
ADMIN_EMAILS=you@socialpostinginc.com

# ── Facebook + Instagram (developers.facebook.com → your app) ──
META_APP_ID=
META_APP_SECRET=
# Optional. Set only if your app uses "Facebook Login for Business" with a configuration:
META_LOGIN_CONFIG_ID=
# Optional overrides:
# META_GRAPH_VERSION=v26.0
# META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish,business_management

# ── Google Business Profile (console.cloud.google.com → OAuth client) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI captions + the free "week of posts" preview (optional) ──
# Without a key, the preview uses built-in templates and the composer's AI button is off.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...   # $19/mo
NEXT_PUBLIC_STRIPE_PRICE_GROWTH=price_...    # $49/mo
NEXT_PUBLIC_STRIPE_PRICE_MANAGED=price_...   # $299/mo (Done for you)
