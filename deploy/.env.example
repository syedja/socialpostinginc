# Social Posting Inc. server settings. Copy to deploy/.env and fill in. Never commit deploy/.env.

# --- Required -----------------------------------------------------------
# The address customers will use (create an A record for it pointing at the VPS IP).
APP_DOMAIN=app.socialpostinginc.com
# Two long random strings. Generate each with:  openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=
# Set to true after you have created your own account if you want sign-ups closed.
DISABLE_REGISTRATION=false
# Link shown in the app to this fork's source code (required by the AGPL licence).
NEXT_PUBLIC_SOURCE_URL=https://github.com/syedja/socialpostinginc

# --- Payments (Stripe). Leave blank to run with billing switched off -----
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From the Stripe webhook you create for https://APP_DOMAIN/api/stripe
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=
FEE_AMOUNT=0.05

# --- AI captions and images (optional) -----------------------------------
OPENAI_API_KEY=

# --- Email (optional; when set, new users must confirm their email) ------
#EMAIL_PROVIDER=resend
#RESEND_API_KEY=
#EMAIL_FROM_ADDRESS=hello@socialpostinginc.com
#EMAIL_FROM_NAME=Social Posting Inc.

# --- Social networks: fill in each one as its developer app is approved ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Google Business Profile (falls back to the YouTube client if left blank)
GOOGLE_GMB_CLIENT_ID=
GOOGLE_GMB_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
API_LIMIT=30
